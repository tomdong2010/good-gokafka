KAFKA_BROKERS=localhost:9092
# comma separated list of topics
KAFKA_TOPIC=test2
KAFKA_GROUP_ID=good-gokafka-consumer
# fallback when a record has no content-type header: proto (default) or json
MESSAGE_FORMAT=proto
# retries before a failing record goes to <topic><DLQ_SUFFIX>
MAX_RETRIES=3
RETRY_BACKOFF=200ms
DLQ_ENABLED=true
DLQ_SUFFIX=.dlq
METRICS_ADDR=:9100
# demo only: fail this fraction of records to exercise retries and the DLQ
SIMULATE_FAILURE_RATE=0
LOG_LEVEL=info
LOG_FORMAT=text
# TLS / SASL for managed Kafka (Confluent Cloud, MSK, ...)
# KAFKA_TLS_ENABLED=true
# KAFKA_TLS_CA_FILE=/path/to/ca.pem
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512   # PLAIN, SCRAM-SHA-256 or SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
