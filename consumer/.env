KAFKA_BROKERS=localhost:9092
# comma separated list of topics
KAFKA_TOPIC=test2
KAFKA_GROUP_ID=good-gokafka-consumer
# fallback when a record has no content-type header: proto (default) or json
MESSAGE_FORMAT=proto
# retries before a failing record goes to <topic><DLQ_SUFFIX>
MAX_RETRIES=3
RETRY_BACKOFF=200ms
DLQ_ENABLED=true
DLQ_SUFFIX=.dlq
